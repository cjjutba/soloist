# ── Soloist environment contract (validated by src/env.ts) ──

# Neon Postgres — POOLED endpoint, used by the serverless WebSocket driver.
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require'

# Better Auth (Story 1.3).
# SECRET: a random string ≥32 chars (generate: `openssl rand -base64 32`). Per-environment.
BETTER_AUTH_SECRET='replace-with-32+-char-random-secret'
# Canonical single-domain origin. Dev: http://localhost:3000 — Prod: https://soloist.cjjutba.com
BETTER_AUTH_URL='http://localhost:3000'

# Email verification transport (Story 1.3). Optional in dev: without a key,
# verification links are logged to the console (dev only; prod throws if unset).
RESEND_API_KEY=''
# EMAIL_FROM defaults to Resend's onboarding sender (works without domain
# verification; Epic 4.3 swaps in a branded one). Leave UNSET to use the default —
# only set it to override. (An empty value coerces to the default in src/env.ts.)
# EMAIL_FROM='onboarding@resend.dev'

# Vercel Blob — Tenant logos (Story 1.6). Optional: the accent contrast guard works
# without it; only logo upload needs it. Vercel auto-injects this when a Blob store is
# linked to the project (Dashboard → Storage → connect a Blob store).
BLOB_READ_WRITE_TOKEN=''

# Sentry (Story 1.7). Optional: no DSN → Sentry is disabled (no errors). Set both to
# activate server + client error capture (Sentry Dashboard → Project → DSN).
# SENTRY_DSN='https://...ingest.sentry.io/...'
# NEXT_PUBLIC_SENTRY_DSN='https://...ingest.sentry.io/...'
# For source-map upload (optional): SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN.

# Later epics add:
#   GITHUB_APP_* / INNGEST_*
