# ── Soloist environment contract (validated by src/env.ts) ──

# Neon Postgres — POOLED endpoint, used by the serverless WebSocket driver.
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require'

# Better Auth (Story 1.3).
# SECRET: a random string ≥32 chars (generate: `openssl rand -base64 32`). Per-environment.
BETTER_AUTH_SECRET='replace-with-32+-char-random-secret'
# Canonical single-domain origin. MUST match the port the dev server actually runs on, because
# Better Auth builds the verify/reset email links from it AND checks it as a trusted origin. The
# `dev` script pins port 3002 (3000/3001 are commonly taken), so dev uses :3002. Prod:
# https://soloist.cjjutba.com. (In dev any localhost port is also trusted — see buildTrustedOrigins.)
BETTER_AUTH_URL='http://localhost:3002'

# ── Email ──
# The mailer (src/server/email/mailer.ts) routes mail by transport. Precedence:
#   EMAIL_TRANSPORT (explicit) > SMTP_HOST present (smtp) > RESEND_API_KEY present (resend) > console.
# DEV: run `npm run mail` (Mailpit) and use the SMTP block below — mail lands in the
#      inbox at http://localhost:8027 and nothing hits Resend (saves quota).
# PROD: leave the SMTP block unset and set RESEND_API_KEY — the Resend SDK sends as before.
# With NO transport: dev logs the link to the console; prod THROWS (mail is never silently dropped).
RESEND_API_KEY=''
# EMAIL_FROM defaults to Resend's onboarding sender (works without domain
# verification; Epic 4.3 swaps in a branded one). Leave UNSET to use the default —
# only set it to override. (An empty value coerces to the default in src/env.ts.)
# EMAIL_FROM='onboarding@resend.dev'

# Local email via Mailpit (`npm run mail` → docker-compose.yml). Uncomment in dev to route
# all mail to the Mailpit inbox. SMTP_HOST alone is enough; the rest default to Mailpit's
# local listener. SMTP_SECURE is false unless set to exactly "true"/"1". Leave UNSET in prod.
# EMAIL_TRANSPORT='smtp'
# SMTP_HOST='localhost'
# SMTP_PORT='1027'
# SMTP_SECURE='false'
# SMTP_USER=''
# SMTP_PASS=''

# Vercel Blob — Tenant logos (Story 1.6). Optional: the accent contrast guard works
# without it; only logo upload needs it. Vercel auto-injects this when a Blob store is
# linked to the project (Dashboard → Storage → connect a Blob store).
BLOB_READ_WRITE_TOKEN=''

# Ably realtime. Server-only ROOT key (Ably Dashboard → App → API keys). The API mints scoped
# subscribe tokens for clients + publishes events. Optional: unset → clients fall back to polling.
ABLY_API_KEY=''

# Sentry (Story 1.7). Optional: no DSN → Sentry is disabled (no errors). Set both to
# activate server + client error capture (Sentry Dashboard → Project → DSN).
# SENTRY_DSN='https://...ingest.sentry.io/...'
# NEXT_PUBLIC_SENTRY_DSN='https://...ingest.sentry.io/...'
# For source-map upload (optional): SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN.

# Later epics add:
#   GITHUB_APP_* / INNGEST_*
