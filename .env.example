# ── Soloist environment contract (validated by src/env.ts) ──
# Copy to .env.local and fill in. Later stories add more vars as they need them.

# Apex domain the app is served under.
#   Production: cjjutba.com
#   Local dev:  localhost   (then visit soloist.localhost:3000 / <slug>.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Reserved subdomain that serves the Cockpit back-office (defaults to "soloist").
NEXT_PUBLIC_COCKPIT_SUBDOMAIN=soloist
